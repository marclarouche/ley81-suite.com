---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE, langs, type Lang } from '../config';

interface Props { lang: Lang; slug: string; title: string; description: string; noindex?: boolean }
const { lang, slug, title, description, noindex = false } = Astro.props;
const path = (l: Lang) => `/${l}/${slug ? slug + '/' : ''}`;
const fullTitle = slug ? `${title} · Ley81·Suite` : title;
const other: Lang = lang === 'es' ? 'en' : 'es';
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={SITE + path(lang)} />
    {langs.map((l) => <link rel="alternate" hreflang={l} href={SITE + path(l)} />)}
    <link rel="alternate" hreflang="x-default" href={SITE + path('es')} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={SITE + path(lang)} />
    <meta property="og:locale" content={lang === 'es' ? 'es_PA' : 'en_US'} />
    <meta property="og:locale:alternate" content={other === 'es' ? 'es_PA' : 'en_US'} />
    <meta name="theme-color" content="#1b3a5c" />
    <link rel="preload" href="/fonts/source-serif-4-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/source-serif-4-latin-600-normal.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <Header lang={lang} slug={slug} />
    <main id="main"><slot /></main>
    <Footer lang={lang} />
  </body>
</html>
