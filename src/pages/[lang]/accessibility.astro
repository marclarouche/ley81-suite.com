---
import Base from '../../layouts/Base.astro';
import { getStaticPaths as gsp, type Lang, CONTACT_EMAIL } from '../../config';
export const getStaticPaths = gsp;
const lang = Astro.params.lang as Lang;
const c = {
  es: { title: 'Declaración de accesibilidad', desc: 'Compromiso de accesibilidad del sitio web de Ley81·Suite, limitaciones conocidas y cómo informarnos de un problema.',
    h1: 'Declaración de accesibilidad',
    lede: 'Queremos que este sitio sea utilizable por todas las personas, incluidas las que usan tecnologías de apoyo.',
    sections: [
      ['Nuestro objetivo', ['Buscamos cumplir las Pautas de Accesibilidad para el Contenido Web (WCAG) 2.2, nivel AA. Este sitio no ha sido sometido a una auditoría independiente, por lo que no declaramos conformidad certificada.']],
      ['Lo que hacemos', ['Estructura semántica de encabezados, regiones y enlaces, con un enlace para saltar al contenido.', 'Navegación completa con teclado e indicador de foco visible.', 'Contraste de color suficiente entre texto y fondo, y texto que se puede ampliar sin perder contenido.', 'Texto alternativo en las imágenes informativas e idioma declarado en cada página (español e inglés).', 'Sin animaciones automáticas, sin ventanas emergentes y sin contenido que parpadee. Se respeta la preferencia de movimiento reducido.', 'Sin cookies de seguimiento ni scripts de terceros.']],
      ['Limitaciones conocidas', ['Los informes de muestra son archivos PDF generados por la aplicación; es posible que no estén totalmente etiquetados para lectores de pantalla.', 'Las imágenes del producto son vistas previas de diseño y su texto interno no es legible por lectores de pantalla; cada una incluye una descripción alternativa.', 'La aplicación de escritorio Ley81·Suite es un producto distinto de este sitio; esta declaración no describe su accesibilidad.']],
      ['Comentarios y contacto', ['Si encuentra una barrera de accesibilidad, escríbanos y le responderemos con una alternativa o una corrección:']],
    ],
    updated: 'Última revisión: 4 de octubre de 2026.',
  },
  en: { title: 'Accessibility statement', desc: 'Accessibility commitment for the Ley81·Suite website, known limitations and how to report a problem.',
    h1: 'Accessibility statement',
    lede: 'We want this website to be usable by everyone, including people who use assistive technology.',
    sections: [
      ['Our aim', ['We aim to meet the Web Content Accessibility Guidelines (WCAG) 2.2, level AA. This site has not been independently audited, so we do not claim certified conformance.']],
      ['What we do', ['Semantic headings, regions and links, with a skip-to-content link.', 'Full keyboard navigation with a visible focus indicator.', 'Sufficient colour contrast between text and background, and text that can be enlarged without losing content.', 'Alternative text on informative images and a declared language on every page (Spanish and English).', 'No auto-playing animation, pop-ups or flashing content. The reduced-motion preference is respected.', 'No tracking cookies and no third-party scripts.']],
      ['Known limitations', ['The sample reports are PDF files generated by the application; they may not be fully tagged for screen readers.', 'Product images are design previews and their internal text is not readable by screen readers; each has an alternative description.', 'The Ley81·Suite desktop application is a separate product from this website; this statement does not describe its accessibility.']],
      ['Feedback and contact', ['If you run into an accessibility barrier, email us and we will reply with an alternative or a fix:']],
    ],
    updated: 'Last reviewed: 4 October 2026.',
  },
}[lang];
---
<Base lang={lang} slug="accessibility" title={c.title} description={c.desc}>
  <div class="page-head"><div class="wrap"><h1>{c.h1}</h1><p class="lede">{c.lede}</p></div></div>
  <section class="block"><div class="wrap prose">
    {c.sections.map(([h, items]) => (
      <>
        <h2>{h}</h2>
        {items.length > 2 ? <ul class="list">{items.map((x) => <li>{x}</li>)}</ul> : items.map((x) => <p>{x}</p>)}
      </>
    ))}
    <p><a href={`mailto:${CONTACT_EMAIL}?subject=${encodeURIComponent(lang === 'es' ? 'Accesibilidad del sitio' : 'Website accessibility')}`}>{CONTACT_EMAIL}</a></p>
    <p class="muted">{c.updated}</p>
  </div></section>
</Base>
