---
import Base from '../../layouts/Base.astro';
import { getStaticPaths as gsp, type Lang } from '../../config';
import { useUi } from '../../i18n/ui';
export const getStaticPaths = gsp;
const lang = Astro.params.lang as Lang;
const t = useUi(lang);
const c = {
  es: { title: 'Para consultores', desc: 'Gestiona varios clientes desde una sola instalación, cada uno en un proyecto cifrado, con informes a nombre de tu firma.',
    h1: 'Para consultores y firmas de consultoría', lede: 'Una instalación, muchos clientes, cada uno aislado en su propio proyecto cifrado.',
    pts: [['Un proyecto cifrado por cliente', 'Cada cliente es una base de datos SQLCipher independiente. Al eliminar un proyecto se aplica borrado criptográfico.'],
      ['Marcos activos por cliente', 'Activa los marcos que apliquen al encargo, de diez disponibles: Ley 81, RGPD, NIST CSF 2.0, ISO/IEC 27001, Ley de IA de la UE y más. La preparación y los filtros siguen esa selección.'],
      ['Informes con tu firma', 'Portada y pie con el nombre y los datos de contacto de tu firma ("Preparado por"), más una pequeña etiqueta "Generado por Ley81·Suite".'],
      ['Entregables bilingües', 'Interfaz e informes en español e inglés, para clientes locales e internacionales.']] },
  en: { title: 'For consultants', desc: 'Run many client engagements from one install, each in an encrypted project, with reports under your firm’s name.',
    h1: 'For consultants and consulting firms', lede: 'One install, many clients, each isolated in its own encrypted project.',
    pts: [['One encrypted project per client', 'Each client is a separate SQLCipher database. Deleting a project applies cryptographic erasure.'],
      ['Active frameworks per client', 'Switch on the frameworks that fit the engagement, from ten available: Law 81, GDPR, NIST CSF 2.0, ISO/IEC 27001, the EU AI Act and more. Readiness and filters follow that selection.'],
      ['Reports under your name', 'Cover page and footer with your firm’s name and contact details (“Prepared by”), plus a small “Generated by Ley81·Suite” label.'],
      ['Bilingual deliverables', 'Interface and reports in Spanish and English, for local and international clients.']] },
}[lang];
---
<Base lang={lang} slug="consultants" title={c.title} description={c.desc}>
  <div class="page-head"><div class="wrap"><p class="eyebrow">{c.title}</p><h1>{c.h1}</h1><p class="lede">{c.lede}</p></div></div>
  <section class="block"><div class="wrap cols-2">{c.pts.map(([h, p]) => <div class="card"><h3>{h}</h3><p>{p}</p></div>)}</div></section>
  <section class="block paper"><div class="wrap"><a class="btn" href={`/${lang}/demo/`}>{t.cta.demo}</a> <a class="btn ghost" href={`/${lang}/samples/`}>{t.cta.samples}</a></div></section>
</Base>
