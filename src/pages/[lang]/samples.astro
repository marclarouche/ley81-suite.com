---
import Base from '../../layouts/Base.astro';
import { getStaticPaths as gsp, type Lang } from '../../config';
export const getStaticPaths = gsp;
const lang = Astro.params.lang as Lang;
const c = {
  es: { title: 'Informes de muestra', desc: 'Descarga informes de muestra generados por Ley81·Suite: atestación, certificado e informe de estado.',
    h1: 'Informes de muestra', lede: 'PDF reales generados por la aplicación con datos ficticios de una firma consultora de ejemplo.',
    items: [
      ['Plan de remediación y atestación (ES)', 'sample_attestation_ES_branded.pdf'],
      ['Remediation Plan & Attestation (EN)', 'sample_attestation_EN_branded.pdf'],
      ['Atestación, instalación de empresa, sin firma consultora (EN)', 'sample_attestation_EN_company_install_no_firm.pdf'],
      ['Certificado de autoevaluación (ES)', 'sample_certificate_ES_branded.pdf'],
      ['Certificate of Self-Assessment (EN)', 'sample_certificate_EN_branded.pdf'],
      ['Informe de estado (EN)', 'sample_status_report_EN_branded.pdf'],
    ],
    note: 'Muestras con datos ficticios. No son informes de un cliente real ni constituyen una certificación.', dl: 'Descargar PDF' },
  en: { title: 'Sample reports', desc: 'Download sample reports generated by Ley81·Suite: attestation, certificate and status report.',
    h1: 'Sample reports', lede: 'Real PDFs generated by the application, using fictional data for an example consulting firm.',
    items: [
      ['Plan de remediación y atestación (ES)', 'sample_attestation_ES_branded.pdf'],
      ['Remediation Plan & Attestation (EN)', 'sample_attestation_EN_branded.pdf'],
      ['Attestation, company install, no consulting firm (EN)', 'sample_attestation_EN_company_install_no_firm.pdf'],
      ['Certificado de autoevaluación (ES)', 'sample_certificate_ES_branded.pdf'],
      ['Certificate of Self-Assessment (EN)', 'sample_certificate_EN_branded.pdf'],
      ['Status Report (EN)', 'sample_status_report_EN_branded.pdf'],
    ],
    note: 'Samples use fictional data. They are not a real client’s reports and are not a certification.', dl: 'Download PDF' },
}[lang];
---
<Base lang={lang} slug="samples" title={c.title} description={c.desc}>
  <div class="page-head"><div class="wrap"><p class="eyebrow">{c.title}</p><h1>{c.h1}</h1><p class="lede">{c.lede}</p></div></div>
  <section class="block"><div class="wrap">
    <div class="cols-2">{c.items.map(([h, f]) => <div class="card"><h3>{h}</h3><p><a href={`/samples/${f}`} download>{c.dl} ↓</a></p></div>)}</div>
    <p class="notice">{c.note}</p>
  </div></section>
</Base>
