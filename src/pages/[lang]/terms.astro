    contact: 'Questions about these terms:',
    updated: 'Last updated: 18 October 2026.',
  },
}[lang];
---
<Base lang={lang} slug="terms" title={c.title} description={c.desc} noindex>
  <div class="page-head"><div class="wrap"><h1>{c.h1}</h1><p class="lede">{c.lede}</p></div></div>
  <section class="block"><div class="wrap prose">
    <p class="notice">{c.notice}</p>
    {c.sections.map((s) => (
      <>
        <h2>{s.h}</h2>
        {s.p && !s.ul && s.p.map((x) => <p>{x}</p>)}
        {s.p && s.ul && s.p.map((x) => <p>{x}</p>)}
        {s.ul && <ul class="list">{s.ul.map((x) => <li>{x}</li>)}</ul>}
        {s.link && <p><a href={`/${lang}${s.link[1]}`}>{s.link[0]}</a></p>}
      </>
    ))}
    <p>{c.contact} <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a></p>
    <p class="muted">{c.updated}</p>
  </div></section>
</Base>
