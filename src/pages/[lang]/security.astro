---
import Base from '../../layouts/Base.astro';
import { getStaticPaths as gsp, type Lang } from '../../config';
export const getStaticPaths = gsp;
const lang = Astro.params.lang as Lang;
const c = {
  es: { title: 'Seguridad y privacidad', desc: 'Cómo protege Ley81·Suite tus datos: local, cifrado en reposo, roles y bitácora de auditoría. Qué afirmamos y qué no.',
    h1: 'Seguridad y privacidad', lede: 'Un resumen honesto de lo que el producto hace hoy.',
    doH: 'Lo que hace hoy',
    does: [
      'Local primero: los datos del cliente viven en tu equipo, en una base SQLCipher cifrada; la bitácora de auditoría es una base cifrada aparte.',
      'Evidencia cifrada en reposo.',
      'Inicio de sesión con el autenticador de la plataforma (Touch ID en macOS; Windows Hello en Windows).',
      'Roles (Administrador, Analista, Auditor, Visor) con segregación de funciones.',
      'Códigos de recuperación de un solo uso; bloqueo de cuenta tras intentos fallidos; reautenticación en acciones sensibles.',
      'Retención de la bitácora por 7 años, con depuración controlada por el Auditor; borrado criptográfico al eliminar un proyecto.',
      'Evaluado internamente frente a CIS Controls v8, Grupo de Implementación 1 (IG1), y sometido a análisis estático y dinámico en septiembre de 2026.',
    ],
    notH: 'Lo que no afirmamos',
    nots: [
      'Estas son evaluaciones internas, no certificaciones ni auditorías de terceros.',
      'El Certificado de autoevaluación incluye un hash SHA-256 de integridad del contenido; no es una firma digital ni una certificación legal.',
      'La aplicación no garantiza el cumplimiento legal: apoya la documentación y la evaluación.',
    ],
    site: 'Este sitio no usa cookies de seguimiento ni scripts de terceros.',
    stolenH: 'Si le roban los archivos o el equipo',
    stolenLede: 'Copiar los archivos de un proyecto a otro computador no da acceso a los datos.',
    stolen: [
      'La clave que abre la base de datos no está en los archivos. Se guarda en el almacén protegido del sistema operativo (Windows DPAPI, ligado a la cuenta de Windows; o el llavero de inicio de sesión de macOS), y el archivo de claves del proyecto solo contiene una referencia.',
      'Si alguien copia la base de datos, la evidencia y el archivo de claves a otro equipo, la clave no está allí: el proyecto no se puede abrir y el acceso a la base de datos es denegado.',
      'Incluso en el equipo original, abrir un proyecto exige Touch ID (macOS) o Windows Hello (Windows).',
    ],
    stolenCaveatH: 'Lo que debe saber',
    stolenCaveats: [
      'El código de recuperación existe para el caso de un equipo perdido y sí puede abrir el proyecto en otro computador, junto con los archivos. Guárdelo aparte y fuera de línea, y nunca junto al equipo. Es de un solo uso: al usarlo se emite uno nuevo.',
      'Un equipo robado y ya desbloqueado, con su sesión abierta, queda protegido solo por la seguridad del propio equipo. Recomendamos cifrado de disco completo, bloqueo de pantalla y cerrar sesión.',
    ],
    cryptoH: 'Criptografía',
    cryptoLede: 'Los algoritmos que protegen la base de datos y la evidencia están aprobados por FIPS: AES-256, SHA-256 y Ed25519. La derivación de claves con Argon2 es la excepción, como se explica abajo.',
    cryptoHead: ['Uso', 'Algoritmo', 'Norma'],
    cryptoRows: [
      ['Base de datos del proyecto (cifrado en reposo, con autenticación por página)', 'AES-256 con HMAC, mediante SQLCipher', 'FIPS 197; FIPS 198-1'],
      ['Clave maestra de cada proyecto', '256 bits aleatorios del generador del sistema operativo, entregados a SQLCipher como clave directa', 'Generador de bits aleatorios del sistema operativo'],
      ['Protección de la clave maestra y cifrado de evidencia', 'AES-256-GCM', 'FIPS 197; NIST SP 800-38D'],
      ['Hash de integridad de informes y verificación de actualizaciones', 'SHA-256', 'FIPS 180-4'],
      ['Firma de manifiestos de actualización', 'Ed25519', 'FIPS 186-5'],
    ],
    cryptoNotes: [
      'Argon2: la clave que envuelve la clave maestra se deriva con Argon2, un estándar moderno y robusto que no es una función de derivación aprobada por FIPS.',
      'Estos son algoritmos aprobados por FIPS. Las implementaciones no son módulos criptográficos validados FIPS 140-2/140-3.',
    ] },
  en: { title: 'Security & privacy', desc: 'How Ley81·Suite protects your data: local-first, encrypted at rest, roles and an audit trail. What we claim and what we don’t.',
    h1: 'Security & privacy', lede: 'An honest summary of what the product does today.',
    doH: 'What it does today',
    does: [
      'Local-first: client data lives on your machine in an encrypted SQLCipher database; the audit trail is a separate encrypted database.',
      'Evidence files encrypted at rest.',
      'Sign-in with the platform authenticator (Touch ID on macOS; Windows Hello on Windows).',
      'Roles (Admin, Analyst, Auditor, Viewer) with segregation of duties.',
      'Single-use recovery codes; account lockout after failed attempts; re-authentication for sensitive actions.',
      '7-year audit-log retention with Auditor-gated purge; cryptographic erasure when a project is deleted.',
      'Assessed internally against CIS Controls v8, Implementation Group 1 (IG1), and run through static and dynamic scans in September 2026.',
    ],
    notH: 'What we do not claim',
    nots: [
      'These are internal assessments, not third-party certifications or audits.',
      'The Certificate of Self-Assessment carries a SHA-256 content integrity hash; it is not a digital signature or a legal certification.',
      'The application does not guarantee legal compliance: it supports documentation and assessment.',
    ],
    site: 'This website uses no tracking cookies and no third-party scripts.',
    stolenH: 'If files or a computer are stolen',
    stolenLede: 'Copying a project’s files to another computer does not give access to the data.',
    stolen: [
      'The key that opens the database is not in the files. It is held in the operating system’s protected store (Windows DPAPI, bound to the Windows account; or the macOS login Keychain), and the project’s keyfile holds only a reference to it.',
      'If someone copies the database, the evidence and the keyfile to another machine, the key is not there: the project cannot be opened and access to the database is denied.',
      'Even on the original machine, opening a project requires Touch ID (macOS) or Windows Hello (Windows).',
    ],
    stolenCaveatH: 'What you should know',
    stolenCaveats: [
      'The recovery code exists for a lost computer and can open the project on another computer together with the files. Keep it separate and offline, never with the computer. It is single-use: using it issues a new one.',
      'A stolen computer that is already unlocked, with the user signed in, is protected only by the computer’s own security. We recommend full-disk encryption, a screen lock and signing out.',
    ],
    cryptoH: 'Cryptography',
    cryptoLede: 'The algorithms that protect the database and evidence files are FIPS-approved: AES-256, SHA-256 and Ed25519. Argon2 key derivation is the one exception, explained below.',
    cryptoHead: ['Use', 'Algorithm', 'Standard'],
    cryptoRows: [
      ['Project database (encrypted at rest, with per-page authentication)', 'AES-256 with HMAC, via SQLCipher', 'FIPS 197; FIPS 198-1'],
      ['Each project’s master key', '256 random bits from the operating system’s generator, handed to SQLCipher as a raw key', 'Operating-system random bit generator'],
      ['Master-key protection and evidence-file encryption', 'AES-256-GCM', 'FIPS 197; NIST SP 800-38D'],
      ['Report integrity hash and update verification', 'SHA-256', 'FIPS 180-4'],
      ['Update-manifest signing', 'Ed25519', 'FIPS 186-5'],
    ],
    cryptoNotes: [
      'Argon2: the key that wraps the master key is derived with Argon2, a modern and strong standard that is not a FIPS-approved key-derivation function.',
      'These are FIPS-approved algorithms. The implementations are not FIPS 140-2/140-3 validated cryptographic modules.',
    ] },
}[lang];
---
<Base lang={lang} slug="security" title={c.title} description={c.desc}>
  <div class="page-head"><div class="wrap"><p class="eyebrow">{c.title}</p><h1>{c.h1}</h1><p class="lede">{c.lede}</p></div></div>
  <section class="block"><div class="wrap prose">
    <h2>{c.doH}</h2><ul class="list">{c.does.map((x) => <li>{x}</li>)}</ul>
    <h2>{c.notH}</h2><ul class="list">{c.nots.map((x) => <li>{x}</li>)}</ul>
    <p class="muted">{c.site}</p>
  </div></section>
  <section class="block" id="stolen"><div class="wrap prose">
    <h2>{c.stolenH}</h2>
    <p class="lede">{c.stolenLede}</p>
    <ul class="list">{c.stolen.map((x) => <li>{x}</li>)}</ul>
    <h3>{c.stolenCaveatH}</h3>
    <ul class="list">{c.stolenCaveats.map((x) => <li>{x}</li>)}</ul>
  </div></section>
  <section class="block paper" id="crypto"><div class="wrap">
    <h2>{c.cryptoH}</h2>
    <p class="lede">{c.cryptoLede}</p>
    <table>
      <thead><tr>{c.cryptoHead.map((h) => <th>{h}</th>)}</tr></thead>
      <tbody>{c.cryptoRows.map(([a, b, d]) => <tr><th scope="row">{a}</th><td>{b}</td><td>{d}</td></tr>)}</tbody>
    </table>
    <ul class="list" style="margin-top:1.5rem">{c.cryptoNotes.map((x) => <li>{x}</li>)}</ul>
  </div></section>
</Base>
