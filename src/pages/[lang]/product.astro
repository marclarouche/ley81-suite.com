---
import Base from '../../layouts/Base.astro';
import { getStaticPaths as gsp, type Lang } from '../../config';
export const getStaticPaths = gsp;
const lang = Astro.params.lang as Lang;
const c = {
  es: {
    title: 'Producto', desc: 'Panel, Sistemas, Brechas, Evidencia e Informes: el flujo completo de Ley81·Suite.',
    h1: 'Del inventario de IA a la atestación', lede: 'Cinco áreas de trabajo que siguen el método GOVERN → MAP → MEASURE → MANAGE.',
    caption: 'Vista previa de diseño. No es una captura de la versión final.',
    alt: 'Vista previa de la pantalla',
    items: [
      ['Panel', 'Preparación por marco activo, avance por fase y brechas por severidad. Dos diseños: Marcador y Libro mayor.', '03-dashboard-a-scoreboard.png'],
      ['Sistemas', 'Inventario de sistemas de IA con categoría de datos, base legal, mecanismo de transferencia, supervisión humana, estado del acuerdo de tratamiento de datos y nivel de riesgo según la Ley de IA de la UE.', '05-ai-systems.png'],
      ['Brechas', 'Hallazgos con severidad calculada (probabilidad × impacto, según sensibilidad de los datos, transferencia y base legal), acción correctiva, responsable, fecha, marcos y bitácora.', '06-gap-register.png'],
      ['Evidencia', 'Todos los documentos cargados, quién los subió y cuándo. Los archivos se cifran en reposo. La evidencia se clasifica como política, procedimiento o prueba.', '09-evidence-vault.png'],
      ['Informes', 'Plan de remediación y atestación (PDF, Word o paquete ZIP con evidencia y manifiesto SHA-256), Certificado de autoevaluación e Informe de estado. En español e inglés.', '10-reports-attestation.png'],
    ],
    note: 'La atestación solo se genera cuando todas las brechas dentro del alcance están remediadas, porque es una declaración incondicional. El Certificado incluye un hash SHA-256 de integridad; no es una firma digital.',
  },
  en: {
    title: 'Product', desc: 'Dashboard, Systems, Gaps, Evidence and Reports: the full Ley81·Suite workflow.',
    h1: 'From AI inventory to attestation', lede: 'Five work areas that follow the GOVERN → MAP → MEASURE → MANAGE method.',
    caption: 'Design preview. Not a capture of the final release.',
    alt: 'Preview of the screen',
    items: [
      ['Dashboard', 'Readiness per active framework, phase progress and gaps by severity. Two layouts: Scoreboard and Ledger.', '03-dashboard-a-scoreboard.png'],
      ['Systems', 'AI systems inventory with data category, legal basis, transfer mechanism, human-in-the-loop, DPA status and EU AI Act risk level.', '05-ai-systems.png'],
      ['Gaps', 'Findings with calculated severity (likelihood × impact, using data sensitivity, transfer and legal basis), corrective action, owner, due date, framework tags and an activity log.', '06-gap-register.png'],
      ['Evidence', 'Every uploaded document, who uploaded it and when. Files are encrypted at rest. Evidence is tiered as policy, procedure or proof.', '09-evidence-vault.png'],
      ['Reports', 'Remediation Plan & Attestation (PDF, Word, or a ZIP package with the evidence files and a SHA-256 manifest), Certificate of Self-Assessment and Status Report. In Spanish and English.', '10-reports-attestation.png'],
    ],
    note: 'The attestation is only generated once every in-scope gap is remediated, because it is an unconditional statement. The Certificate carries a SHA-256 integrity hash; it is not a digital signature.',
  },
}[lang];
---
<Base lang={lang} slug="product" title={c.title} description={c.desc}>
  <div class="page-head"><div class="wrap"><p class="eyebrow">{c.title}</p><h1>{c.h1}</h1><p class="lede">{c.lede}</p></div></div>
  {c.items.map(([h, p, img], i) => (
    <section class={`block ${i % 2 ? '' : 'paper'}`}>
      <div class="wrap hero-grid">
        <div class={i % 2 ? 'order-2' : undefined}><h2>{h}</h2><p class="lede">{p}</p></div>
        <figure class="fig"><img class="shot" src={`/img/${img}`} alt={`${c.alt}: ${h}`} width="1200" height="800" loading="lazy" /><figcaption class="caption">{c.caption}</figcaption></figure>
      </div>
    </section>
  ))}
  <section class="block"><div class="wrap"><p class="notice">{c.note}</p></div></section>
</Base>
